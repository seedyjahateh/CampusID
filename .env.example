# Copy to .env and adjust. `.env` is git-ignored and must never be committed.
#
#   cp .env.example .env && docker compose up -d --wait
#
# Every value here is a non-secret placeholder for local development. Real
# deployments inject these from a secrets backend (Vault / AWS Secrets Manager);
# see docs/runbooks/key-rotation.md.

# --- Data tier --------------------------------------------------------------
POSTGRES_USER=campusid
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=campusid
# The application connects as `campusid_app`, a role with no DDL rights and only
# SELECT and INSERT on the audit trail (FR-AUD-04). Migration 0015 creates it and
# sets this password; migrations themselves keep using POSTGRES_USER, because
# they must own the schema and the application must not.
APP_DB_PASSWORD=change-me-local-only-app
# Host ports for the data tier. Deliberately off the standard 5432/6379 so the
# stack starts on a machine that already runs Postgres or Redis — inside the
# compose network the services still use their default ports.
POSTGRES_PORT=55432
REDIS_PORT=56379

# --- Broker -----------------------------------------------------------------
BROKER_PORT=8000

# dev | ci | production
CAMPUSID_ENVIRONMENT=dev

# Issuer and SAML entityID base. Must be stable: changing it invalidates every
# registered peer's configuration and every pairwise identifier derivation.
CAMPUSID_BASE_URL=http://localhost:8000

# DEBUG | INFO | WARNING | ERROR
CAMPUSID_LOG_LEVEL=INFO
# json | console  (use `console` for readable local output)
CAMPUSID_LOG_FORMAT=json

# The IdP /saml/sso uses when the caller names none. Keycloak's SAML entityID
# is its realm URL, so this must agree with KEYCLOAK_PUBLIC_URL below — change
# one and you must change the other.
CAMPUSID_SAML_DEFAULT_IDP=http://localhost:18080/realms/campus

# --- Attribute release ------------------------------------------------------
# This deployment's own scope: the domain the campus IdP is authoritative for.
# An eduPersonPrincipalName scoped to anything else is dropped during
# normalisation, and this is the suffix on every subject identifier we issue.
CAMPUSID_SCOPE=campus.test

# Restore-critical, and the one value here that is genuinely a secret.
#
# Every SP's identifier for every person is derived from it, so changing it
# replaces each SP's entire user base with strangers simultaneously. Back it up
# with the database; rotating it is a coordinated migration, not an operation.
# The broker refuses to start with CAMPUSID_ENVIRONMENT=production while this
# still holds its development value.
CAMPUSID_PAIRWISE_SALT=dev-only-pairwise-salt-replace-in-production

# Attempts a minute on the authentication endpoints (NFR-SEC-10). The
# requirement's number is 10, which is right for one browser and wrong for a
# campus behind a single NAT gateway where one address is ten thousand people.
# The compose stack raises it far above the default because the integration
# suite drives the whole of itself out of one container; a real deployment sets
# it from how its clients actually reach the broker.
CAMPUSID_AUTH_RATE_PER_ADDRESS=10000

# --- federation profile -----------------------------------------------------
# Only used by `docker compose --profile federation`.
#
# Off the standard 8080 so the stack starts on a machine already running
# something there, matching the data-tier ports above.
KEYCLOAK_PORT=18080

# Must be what the *browser* can reach: Keycloak generates the URLs in its SAML
# descriptor from this. The broker fetches that descriptor over the internal
# network and still gets browser-usable URLs, which is what lets the whole
# stack work without a hosts-file entry.
KEYCLOAK_PUBLIC_URL=http://localhost:18080

KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-local-only

# --- Directory (M4) --------------------------------------------------------
# The development OpenLDAP, behind the `directory` compose profile.
LDAP_PORT=1389
LDAP_ADMIN_PASSWORD=change-me-local-only

# Empty by default, so a broker started without the directory profile has no
# directory rather than one it cannot reach. Set this to point the broker at
# the container:
#
#   CAMPUSID_LDAP_URL=ldap://openldap:389
#   CAMPUSID_LDAP_BIND_DN=cn=admin,dc=campus,dc=test
#   CAMPUSID_LDAP_BIND_PASSWORD=change-me-local-only
#   CAMPUSID_LDAP_ALLOW_PLAINTEXT=true
#
# The last of those is refused in production, and the dev directory has no
# certificate for StartTLS to validate.
CAMPUSID_LDAP_URL=
CAMPUSID_LDAP_PROFILE=openldap
CAMPUSID_LDAP_BASE_DN=dc=campus,dc=test
CAMPUSID_LDAP_BIND_DN=
CAMPUSID_LDAP_BIND_PASSWORD=
CAMPUSID_LDAP_START_TLS=false
CAMPUSID_LDAP_ALLOW_PLAINTEXT=false
