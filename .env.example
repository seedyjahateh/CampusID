# Copy to .env and adjust. `.env` is git-ignored and must never be committed.
#
#   cp .env.example .env && docker compose up -d --wait
#
# Every value here is a non-secret placeholder for local development. Real
# deployments inject these from a secrets backend (Vault / AWS Secrets Manager);
# see docs/runbooks/key-rotation.md.

# --- Data tier --------------------------------------------------------------
POSTGRES_USER=campusid
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=campusid
# Host ports for the data tier. Deliberately off the standard 5432/6379 so the
# stack starts on a machine that already runs Postgres or Redis — inside the
# compose network the services still use their default ports.
POSTGRES_PORT=55432
REDIS_PORT=56379

# --- Broker -----------------------------------------------------------------
BROKER_PORT=8000

# dev | ci | production
CAMPUSID_ENVIRONMENT=dev

# Issuer and SAML entityID base. Must be stable: changing it invalidates every
# registered peer's configuration and every pairwise identifier derivation.
CAMPUSID_BASE_URL=http://localhost:8000

# DEBUG | INFO | WARNING | ERROR
CAMPUSID_LOG_LEVEL=INFO
# json | console  (use `console` for readable local output)
CAMPUSID_LOG_FORMAT=json
